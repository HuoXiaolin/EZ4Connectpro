@@ -0,0 +1,55 @@
+package tun
+
+import (
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+func TestTunnelRouteConflicts(t *testing.T) {
+	active := activeTunnels{
+		addresses: map[netip.Addr]string{netip.MustParseAddr("20.0.0.108"): "office"},
+		routes: []tunnelRoute{
+			{netip.MustParsePrefix("10.16.0.0/16"), "office"},
+			{netip.MustParsePrefix("198.18.0.0/15"), "Clash"},
+		},
+		dnsAdapter: "office",
+	}
+	tests := []struct {
+		name     string
+		ip       string
+		route    string
+		hijack   bool
+		conflict string
+	}{
+		{"disjoint", "20.0.0.109", "10.17.0.0/16", false, ""},
+		{"duplicate virtual address", "20.0.0.108", "10.17.0.0/16", false, "虚拟 IP"},
+		{"contained network", "20.0.0.109", "10.16.1.0/24", false, "10.16.0.0/16"},
+		{"containing network", "20.0.0.109", "10.0.0.0/8", false, "10.16.0.0/16"},
+		{"virtual address hits active route", "10.16.0.7", "10.17.0.0/16", false, "虚拟 IP"},
+		{"Clash fake IP overlaps", "20.0.0.109", "198.18.0.0/16", false, "Clash"},
+		{"DNS hijack already claimed", "20.0.0.109", "10.17.0.0/16", true, "DNS"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			err := active.check(netip.MustParseAddr(tc.ip), []netip.Prefix{netip.MustParsePrefix(tc.route)}, tc.hijack)
+			if tc.conflict == "" {
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else if err == nil || !strings.Contains(err.Error(), tc.conflict) {
+				t.Fatalf("want conflict containing %q, got %v", tc.conflict, err)
+			}
+		})
+	}
+}
+
+func TestParseTunnelRoutes(t *testing.T) {
+	routes, err := parseTunnelRoutes([]string{"10.16.0.9/16", "10.16.0.0/16", "fd00::/64"})
+	if err != nil || len(routes) != 1 || routes[0].String() != "10.16.0.0/16" {
+		t.Fatalf("unexpected normalized routes: %v, %v", routes, err)
+	}
+	if _, err := parseTunnelRoutes([]string{"0.0.0.0/0"}); err == nil {
+		t.Fatal("server default route must be rejected")
+	}
+}
