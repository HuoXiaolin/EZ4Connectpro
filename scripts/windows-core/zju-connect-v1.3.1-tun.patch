new file mode 100644
--- /dev/null
+++ b/stack/tun/routes_windows.go
@@ -0,0 +1,152 @@
+package tun
+
+import (
+	"errors"
+	"fmt"
+	"net/netip"
+	"runtime"
+	"strings"
+
+	"github.com/mythologyli/zju-connect/log"
+	"golang.org/x/sys/windows"
+	"golang.zx2c4.com/wireguard/windows/tunnel/winipcfg"
+)
+
+const fallbackRouteMetric = 9999
+
+var fakeRoute = netip.MustParsePrefix("198.18.0.0/16")
+var fakeDNSAddress = netip.MustParseAddr("198.18.0.1")
+var broadcastRoute = netip.MustParsePrefix("255.255.255.255/32")
+
+type tunnelRoute struct {
+	prefix  netip.Prefix
+	adapter string
+}
+
+type activeTunnels struct {
+	addresses  map[netip.Addr]string
+	routes     []tunnelRoute
+	dnsAdapter string
+}
+
+func parseTunnelRoutes(targets []string) ([]netip.Prefix, error) {
+	routes := make([]netip.Prefix, 0, len(targets))
+	seen := make(map[netip.Prefix]bool, len(targets))
+	for _, target := range targets {
+		prefix, err := netip.ParsePrefix(target)
+		if err != nil {
+			return nil, fmt.Errorf("invalid TUN route %q: %w", target, err)
+		}
+		if !prefix.Addr().Is4() {
+			log.Printf("Skip unsupported IPv6 TUN route %s", prefix)
+			continue
+		}
+		if prefix.Bits() == 0 {
+			return nil, fmt.Errorf("TUN conflict: 网关下发了默认路由 %s，请使用分流网段", prefix)
+		}
+		prefix = prefix.Masked()
+		if !seen[prefix] {
+			routes = append(routes, prefix)
+			seen[prefix] = true
+		}
+	}
+	return routes, nil
+}
+
+func lockTunnelSetup() (func(), error) {
+	name := windows.StringToUTF16Ptr(`Global\EZ4Connectpro-TunRouteSetup`)
+	mutex, err := windows.CreateMutex(nil, false, name)
+	if err != nil && !errors.Is(err, windows.ERROR_ALREADY_EXISTS) {
+		return nil, fmt.Errorf("open TUN route lock: %w", err)
+	}
+	runtime.LockOSThread()
+	event, err := windows.WaitForSingleObject(mutex, 15000)
+	if err != nil || (event != windows.WAIT_OBJECT_0 && event != windows.WAIT_ABANDONED) {
+		windows.CloseHandle(mutex)
+		runtime.UnlockOSThread()
+		if err != nil {
+			return nil, fmt.Errorf("wait for TUN route lock: %w", err)
+		}
+		return nil, fmt.Errorf("TUN conflict: 另一条连接正在配置网卡，请稍后重试")
+	}
+	return func() {
+		windows.ReleaseMutex(mutex)
+		windows.CloseHandle(mutex)
+		runtime.UnlockOSThread()
+	}, nil
+}
+
+func readActiveTunnels() (activeTunnels, error) {
+	active := activeTunnels{addresses: make(map[netip.Addr]string)}
+	adapters, err := winipcfg.GetAdaptersAddresses(windows.AF_INET, winipcfg.GAAFlagDefault)
+	if err != nil {
+		return active, fmt.Errorf("read IPv4 adapters: %w", err)
+	}
+	managed := make(map[winipcfg.LUID]bool)
+	names := make(map[winipcfg.LUID]string)
+	for _, adapter := range adapters {
+		name := adapter.FriendlyName()
+		names[adapter.LUID] = name
+		isTunnel := strings.EqualFold(name, legacyInterfaceName) || strings.HasPrefix(strings.ToLower(name), strings.ToLower(adapterPrefix))
+		managed[adapter.LUID] = isTunnel
+		for entry := adapter.FirstUnicastAddress; entry != nil; entry = entry.Next {
+			ip, ok := netip.AddrFromSlice(entry.Address.IP())
+			if ok && ip.Unmap().Is4() {
+				active.addresses[ip.Unmap()] = name
+			}
+		}
+		if isTunnel {
+			for dns := adapter.FirstDNSServerAddress; dns != nil; dns = dns.Next {
+				ip, ok := netip.AddrFromSlice(dns.Address.IP())
+				if ok && (ip.Unmap() == fakeDNSAddress || active.addresses[ip.Unmap()] == name) {
+					active.dnsAdapter = name
+					break
+				}
+			}
+		}
+	}
+
+	table, err := winipcfg.GetIPForwardTable2(windows.AF_INET)
+	if err != nil {
+		return active, fmt.Errorf("read Windows IPv4 route table: %w", err)
+	}
+	for _, row := range table {
+		prefix := row.DestinationPrefix.Prefix()
+		if !prefix.IsValid() || !prefix.Addr().Is4() || prefix.Addr().IsMulticast() ||
+			prefix == broadcastRoute {
+			continue
+		}
+		if prefix.Bits() == 0 && (!managed[row.InterfaceLUID] || row.Metric >= fallbackRouteMetric) {
+			continue
+		}
+		if managed[row.InterfaceLUID] || prefix.Overlaps(fakeRoute) {
+			name := names[row.InterfaceLUID]
+			if name == "" {
+				name = fmt.Sprintf("接口 %d", row.InterfaceIndex)
+			}
+			active.routes = append(active.routes, tunnelRoute{prefix, name})
+		}
+	}
+	return active, nil
+}
+
+func (active activeTunnels) check(ip netip.Addr, routes []netip.Prefix, dnsHijack bool) error {
+	if adapter, found := active.addresses[ip]; found {
+		return fmt.Errorf("TUN conflict: 虚拟 IP %s 已由网卡 %s 使用", ip, adapter)
+	}
+	if dnsHijack && active.dnsAdapter != "" {
+		return fmt.Errorf("TUN conflict: 网卡 %s 已启用 DNS 劫持", active.dnsAdapter)
+	}
+	host := netip.PrefixFrom(ip, 32)
+	for _, existing := range active.routes {
+		if host.Overlaps(existing.prefix) {
+			return fmt.Errorf("TUN conflict: 虚拟 IP %s 与网卡 %s 的路由 %s 重叠", ip, existing.adapter, existing.prefix)
+		}
+		for _, desired := range routes {
+			if desired.Overlaps(existing.prefix) {
+				return fmt.Errorf("TUN conflict: 网段 %s 与网卡 %s 的路由 %s 重叠", desired, existing.adapter, existing.prefix)
+			}
+		}
+	}
+	return nil
+}
