+func (ep *Endpoint) dial(ctx context.Context, network string, local, remote net.Addr) (net.Conn, error) {
+	dialer := net.Dialer{
+		LocalAddr: local,
+		Control: func(_, _ string, socket syscall.RawConn) error {
+			var optionError error
+			err := socket.Control(func(fd uintptr) {
+				index := bits.ReverseBytes32(ep.interfaceIndex)
+				optionError = windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IP, ipUnicastInterface, int(index))
+			})
+			if err != nil {
+				return err
+			}
+			return optionError
+		},
+	}
+	return dialer.DialContext(ctx, network, remote.String())
+}
 
